# Deployer key for `npm run foundry:deploy:*`. Create one with `npm run foundry:account:generate`,
# then fund its address at https://portal.hedera.com/faucet. Testnet only: this file is not encrypted.
DEPLOYER_PRIVATE_KEY=

# RPC endpoints (defaults shown).
HEDERA_RPC_URL=https://testnet.hashio.io/api
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# DAO settings for `npm run foundry:deploy:hedera`. Times in seconds; short values suit a demo.
GOV_TOKEN_NAME="DAO Governance"
GOV_TOKEN_SYMBOL=HGOV
VOTING_DELAY_SECONDS=60
VOTING_PERIOD_SECONDS=300
TIMELOCK_DELAY_SECONDS=120
QUORUM_PERCENT=4
PROPOSAL_THRESHOLD_TOKENS=0
FAUCET_CLAIM_TOKENS=1000
FAUCET_COOLDOWN_SECONDS=86400
# How long a cross-chain request stays executable on the remote chain after it is sent.
REQUEST_TTL_SECONDS=86400

# Gas the network gets for each scheduled callback. Measured use: queue 1.6-2.2M, execute 0.1-0.55M
# (docs/costs.md). Only the gas used is billed, but the governor's float must hold gas x gas price
# (about 83 tinybar per gas on testnet) when a callback fires, or the network skips it.
AUTO_QUEUE_GAS=3000000
AUTO_EXECUTE_GAS=1500000

# HBAR the deploy script sends: token creation fee (unused part is returned), callback float, treasury.
TOKEN_CREATE_HBAR=30
GOVERNOR_FLOAT_HBAR=15
TREASURY_HBAR=20
