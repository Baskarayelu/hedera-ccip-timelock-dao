{
  "name": "@sh/foundry",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "account:generate": "node scripts-js/generateAccount.js",
    "clean": "forge clean",
    "compile": "forge compile",
    "deploy:hedera": "forge compile && node scripts-js/deployHedera.js",
    "deploy:remote": "forge compile && node scripts-js/deployRemote.js",
    "export": "node scripts-js/exportContracts.js",
    "format": "make format",
    "lint": "make lint",
    "test": "forge test",
    "verify:testnet": "forge verify-contract --chain-id 296 --verifier sourcify",
    "verify:base-sepolia": "forge verify-contract --chain-id 84532 --verifier sourcify",
    "postinstall": "shx cp -n .env.example .env",
    "verify:hedera": "node scripts-js/verifyHedera.js"
  },
  "dependencies": {
    "dotenv": "16.3.2",
    "prettier": "3.8.1",
    "viem": "2.39.0"
  },
  "devDependencies": {
    "shx": "0.3.4"
  }
}
